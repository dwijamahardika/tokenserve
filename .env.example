# Copy to .env (git-ignored) and load it into the environment, or pass it to
# `docker run --env-file .env`. Every CLI flag can be set as TOKENSERVE_<FLAG>;
# an empty value means "use the default".

# Bearer token required on /v1/* when set. Default: no auth.
TOKENSERVE_API_KEY=

# Listeners. Defaults: 127.0.0.1:8000 (API) and 127.0.0.1:9090 (metrics/health).
TOKENSERVE_HOST=
TOKENSERVE_PORT=
TOKENSERVE_ADMIN_HOST=
TOKENSERVE_ADMIN_PORT=

# debug | info | warning | error. Default: info.
TOKENSERVE_LOG_LEVEL=
